{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:templates": "tsx scripts/gen-vanilla-templates.ts",
		"gen:powers": "tsx scripts/gen-builtin-powers-catalog.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:schema": "tsx src/lib/schema/__tests__/parse.test.ts",
		"check:seed": "tsx src/lib/schema/__tests__/fieldSeed.test.ts",
		"check:export": "tsx src/lib/datapack/__tests__/export.test.ts",
		"check:import": "tsx src/lib/datapack/__tests__/import.test.ts",
		"check:mob": "tsx src/lib/datapack/__tests__/mobImport.test.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.3",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"blockly": "^12.5.1",
		"fflate": "^0.8.3"
	}
}
