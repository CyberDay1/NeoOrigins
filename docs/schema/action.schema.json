{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoorigins.example/schema/action.schema.json",
  "title": "NeoOrigins Action",
  "description": "A side-effect action used in `entity_action` fields. The `type` field discriminates.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "description": "Fully-qualified action verb. `apace:` aliases are accepted.",
      "enum": [
        "neoorigins:and",
        "neoorigins:chance",
        "neoorigins:delay",
        "neoorigins:if_else",
        "neoorigins:if_else_list",
        "neoorigins:nothing",
        "neoorigins:damage",
        "neoorigins:heal",
        "neoorigins:feed",
        "neoorigins:exhaust",
        "neoorigins:change_resource",
        "neoorigins:apply_effect",
        "neoorigins:clear_effect",
        "neoorigins:add_velocity",
        "neoorigins:launch",
        "neoorigins:set_fall_distance",
        "neoorigins:dismount",
        "neoorigins:give",
        "neoorigins:modify_food",
        "neoorigins:spawn_entity",
        "neoorigins:spawn_projectile",
        "neoorigins:set_block",
        "neoorigins:set_on_fire",
        "neoorigins:extinguish",
        "neoorigins:explode",
        "neoorigins:gain_air",
        "neoorigins:area_of_effect",
        "neoorigins:grant_power",
        "neoorigins:revoke_power",
        "neoorigins:trigger_cooldown",
        "neoorigins:execute_command",
        "neoorigins:play_sound",
        "neoorigins:swing_hand",
        "neoorigins:emit_game_event",
        "neoorigins:toggle",
        "neoorigins:add_to_set",
        "neoorigins:remove_from_set",
        "neoorigins:chain_to_nearest",
        "neoorigins:pull_entities",
        "neoorigins:throw_target",
        "neoorigins:swap_with_entity",
        "neoorigins:teleport_to_marker",
        "neoorigins:damage_attacker",
        "neoorigins:ignite_attacker",
        "neoorigins:effect_on_attacker",
        "neoorigins:random_teleport",
        "neoorigins:cancel_event",
        "apace:damage",
        "apace:heal",
        "apace:feed",
        "apace:apply_effect",
        "apace:and",
        "apace:chance",
        "apace:give",
        "apace:execute_command",
        "apace:set_block",
        "apace:spawn_entity",
        "apace:spawn_projectile",
        "apace:area_of_effect",
        "neoorigins:and",
        "neoorigins:chance",
        "neoorigins:delay",
        "neoorigins:if_else",
        "neoorigins:if_else_list",
        "neoorigins:nothing",
        "neoorigins:damage",
        "neoorigins:heal",
        "neoorigins:feed",
        "neoorigins:exhaust",
        "neoorigins:change_resource",
        "neoorigins:apply_effect",
        "neoorigins:clear_effect",
        "neoorigins:add_velocity",
        "neoorigins:launch",
        "neoorigins:set_fall_distance",
        "neoorigins:dismount",
        "neoorigins:give",
        "neoorigins:modify_food",
        "neoorigins:spawn_entity",
        "neoorigins:spawn_projectile",
        "neoorigins:set_block",
        "neoorigins:set_on_fire",
        "neoorigins:extinguish",
        "neoorigins:explode",
        "neoorigins:gain_air",
        "neoorigins:area_of_effect",
        "neoorigins:grant_power",
        "neoorigins:revoke_power",
        "neoorigins:trigger_cooldown",
        "neoorigins:execute_command",
        "neoorigins:play_sound",
        "neoorigins:swing_hand",
        "neoorigins:emit_game_event"
      ]
    }
  },
  "oneOf": [
    {
      "$comment": "neoorigins:and / origins:if_else / origins:if_else_list \u00e2\u20ac\u201d combinators",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:and",
            "apace:and",
            "neoorigins:and"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "type",
        "actions"
      ]
    },
    {
      "$comment": "neoorigins:chance",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:chance",
            "apace:chance",
            "neoorigins:chance"
          ]
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "success_action": {
          "$ref": "#"
        },
        "fail_action": {
          "$ref": "#"
        }
      },
      "required": [
        "type",
        "chance"
      ]
    },
    {
      "$comment": "neoorigins:delay",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:delay",
            "neoorigins:delay"
          ]
        },
        "ticks": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "$ref": "#"
        }
      },
      "required": [
        "type",
        "action"
      ]
    },
    {
      "$comment": "neoorigins:if_else",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:if_else",
            "neoorigins:if_else"
          ]
        },
        "condition": {
          "$ref": "condition.schema.json"
        },
        "if_action": {
          "$ref": "#"
        },
        "else_action": {
          "$ref": "#"
        }
      },
      "required": [
        "type",
        "condition"
      ]
    },
    {
      "$comment": "neoorigins:damage",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:damage",
            "apace:damage",
            "neoorigins:damage"
          ]
        },
        "amount": {
          "type": "number"
        },
        "source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:heal / origins:feed / origins:exhaust / origins:gain_air",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:heal",
            "neoorigins:feed",
            "neoorigins:exhaust",
            "neoorigins:gain_air",
            "apace:heal",
            "apace:feed",
            "neoorigins:heal",
            "neoorigins:feed",
            "neoorigins:exhaust",
            "neoorigins:gain_air"
          ]
        },
        "amount": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "amount"
      ]
    },
    {
      "$comment": "neoorigins:apply_effect",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:apply_effect",
            "apace:apply_effect",
            "neoorigins:apply_effect"
          ]
        },
        "effect": {
          "type": "string"
        },
        "duration": {
          "type": "integer",
          "minimum": 1
        },
        "amplifier": {
          "type": "integer",
          "minimum": 0
        },
        "is_ambient": {
          "type": "boolean"
        },
        "show_particles": {
          "type": "boolean"
        },
        "show_icon": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "effect"
      ]
    },
    {
      "$comment": "neoorigins:clear_effect",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:clear_effect",
            "neoorigins:clear_effect"
          ]
        },
        "effect": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:add_velocity",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:add_velocity",
            "neoorigins:add_velocity"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "set": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:launch",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:launch",
            "neoorigins:launch"
          ]
        },
        "speed": {
          "type": "number"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:give",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:give",
            "apace:give",
            "neoorigins:give"
          ]
        },
        "stack": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "item"
          ]
        }
      },
      "required": [
        "type",
        "stack"
      ]
    },
    {
      "$comment": "neoorigins:execute_command",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:execute_command",
            "apace:execute_command",
            "neoorigins:execute_command"
          ]
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "command"
      ]
    },
    {
      "$comment": "neoorigins:play_sound",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:play_sound",
            "neoorigins:play_sound"
          ]
        },
        "sound": {
          "type": "string"
        },
        "volume": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "sound"
      ]
    },
    {
      "$comment": "neoorigins:spawn_entity",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:spawn_entity",
            "apace:spawn_entity",
            "neoorigins:spawn_entity"
          ]
        },
        "entity_type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "entity_type"
      ]
    },
    {
      "$comment": "neoorigins:spawn_projectile",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:spawn_projectile",
            "apace:spawn_projectile",
            "neoorigins:spawn_projectile"
          ]
        },
        "entity_type": {
          "type": "string"
        },
        "speed": {
          "type": "number"
        },
        "divergence": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "entity_type"
      ]
    },
    {
      "$comment": "neoorigins:area_of_effect",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:area_of_effect",
            "apace:area_of_effect",
            "neoorigins:area_of_effect"
          ]
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "entity_action": {
          "$ref": "#"
        },
        "include_source": {
          "type": "boolean"
        },
        "duration": {
          "type": "integer"
        },
        "duration_ticks": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "radius"
      ]
    },
    {
      "$comment": "neoorigins:grant_power / origins:revoke_power",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:grant_power",
            "neoorigins:revoke_power",
            "neoorigins:grant_power",
            "neoorigins:revoke_power"
          ]
        },
        "power": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "power"
      ]
    },
    {
      "$comment": "neoorigins:toggle",
      "properties": {
        "type": {
          "const": "neoorigins:toggle"
        },
        "power": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "power"
      ]
    },
    {
      "$comment": "neoorigins:add_to_set / neoorigins:remove_from_set",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:add_to_set",
            "neoorigins:add_to_set",
            "neoorigins:remove_from_set",
            "neoorigins:remove_from_set"
          ]
        },
        "set": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "set"
      ]
    },
    {
      "$comment": "neoorigins:nothing",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:nothing",
            "neoorigins:nothing"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:if_else_list",
      "properties": {
        "type": {"const": "neoorigins:if_else_list"},
        "actions": {"type": "array", "items": {"type": "object"}, "description": "List of {condition, action} branches; first matching condition wins."}
      },
      "required": ["type", "actions"]
    },
    {
      "$comment": "neoorigins:dash",
      "properties": {
        "type": {"const": "neoorigins:dash"},
        "strength": {"type": "number", "description": "Impulse magnitude along player look vector (default 1.5)."},
        "allow_vertical": {"type": "boolean", "description": "If false, dash is pinned to horizontal (default true)."},
        "set_velocity": {"type": "boolean", "description": "If true, replaces delta movement instead of pushing additively."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:exhaust",
      "properties": {
        "type": {"const": "neoorigins:exhaust"},
        "amount": {"type": "number", "minimum": 0, "description": "Exhaustion points added (default 1.0)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:change_resource / modify_resource",
      "properties": {
        "type": {"enum": ["neoorigins:change_resource", "neoorigins:modify_resource"]},
        "resource": {"type": "string", "description": "Resource power id (matches the bar's defining power)."},
        "operation": {"enum": ["add", "set"], "description": "add (default) clamps within bar bounds; set assigns directly."},
        "change": {"type": "integer", "description": "Amount to add or value to set."}
      },
      "required": ["type", "resource"]
    },
    {
      "$comment": "neoorigins:trigger_cooldown",
      "properties": {
        "type": {"const": "neoorigins:trigger_cooldown"},
        "power": {"type": "string", "description": "Power id whose cooldown to start."},
        "cooldown": {"type": "integer", "minimum": 0, "description": "Cooldown duration in ticks (20 = 1s; default 20)."}
      },
      "required": ["type", "power"]
    },
    {
      "$comment": "neoorigins:gain_air",
      "properties": {
        "type": {"const": "neoorigins:gain_air"},
        "amount": {"type": "integer", "description": "Air-supply ticks to add, clamped to max (default 10)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:set_fall_distance",
      "properties": {
        "type": {"const": "neoorigins:set_fall_distance"},
        "fall_distance": {"type": "number", "description": "New fall distance value (default 0.0 \u2014 resets fall damage)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:extinguish",
      "properties": {"type": {"const": "neoorigins:extinguish"}},
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:dismount",
      "properties": {"type": {"const": "neoorigins:dismount"}},
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:explode",
      "properties": {
        "type": {"const": "neoorigins:explode"},
        "power": {"type": "number", "minimum": 0, "description": "Explosion strength (default 3.0; TNT = 4)."},
        "destruction_type": {"enum": ["none", "break", "destroy"], "description": "Block-interaction mode; 'none' is entity-only (default 'none')."},
        "create_fire": {"type": "boolean", "description": "Spawn fire on affected blocks (default false)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:set_block",
      "properties": {
        "type": {"const": "neoorigins:set_block"},
        "block": {"type": "string", "description": "Block id to place at the player's position."},
        "keep": {"type": "boolean", "description": "If true, only place when current block is air (default false)."}
      },
      "required": ["type", "block"]
    },
    {
      "$comment": "neoorigins:modify_food",
      "properties": {
        "type": {"const": "neoorigins:modify_food"},
        "food": {"type": "integer", "description": "Food points delta (alias: food_component_food)."},
        "saturation": {"type": "number", "description": "Saturation delta (alias: food_component_saturation)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:emit_game_event",
      "properties": {
        "type": {"const": "neoorigins:emit_game_event"},
        "event": {"type": "string", "description": "GameEvent id, e.g. minecraft:hit_ground (alias: game_event)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:swing_hand",
      "properties": {"type": {"const": "neoorigins:swing_hand"}},
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:drop_items",
      "properties": {
        "type": {"const": "neoorigins:drop_items"},
        "mode": {"enum": ["each", "one_of", "single", "weighted"], "description": "'each' rolls every entry independently; 'one_of' picks one weighted by 'weight'."},
        "rolls": {"type": "integer", "minimum": 1, "description": "Number of weighted picks in one_of mode (default 1; ignored in each mode)."},
        "items": {"type": "array", "items": {"type": "object"}, "description": "Drop entries \u2014 each: {item, count (int|[min,max]), chance (each-mode), weight (one_of-mode)}."}
      },
      "required": ["type", "items"]
    },
    {
      "$comment": "neoorigins:spawn_lingering_area",
      "properties": {
        "type": {"const": "neoorigins:spawn_lingering_area"},
        "radius": {"type": "number", "description": "Effect cloud radius (default 3.0)."},
        "duration_ticks": {"type": "integer", "minimum": 1, "description": "Lifetime in ticks (default 100)."},
        "interval_ticks": {"type": "integer", "minimum": 1, "description": "Ticks between entity_action firings (default 20)."},
        "effect_type": {"type": "string", "description": "Visual effect palette id (client-side; optional)."},
        "particle_type": {"type": "string", "description": "Particle id rendered (default minecraft:witch)."},
        "entity_action": {"$ref": "#", "description": "Action run every interval against caught entities."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:spawn_black_hole",
      "properties": {
        "type": {"const": "neoorigins:spawn_black_hole"},
        "radius": {"type": "number", "description": "Pull radius (default 6.0)."},
        "duration_ticks": {"type": "integer", "minimum": 1, "description": "Lifetime (default 100)."},
        "pull_strength": {"type": "number", "description": "Per-tick pull magnitude (default 1.5)."},
        "damage_per_tick": {"type": "number", "description": "Damage applied per tick to caught entities (default 2.0)."},
        "effect_type": {"type": "string", "description": "Visual palette id (client-side; optional)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:spawn_tornado",
      "properties": {
        "type": {"const": "neoorigins:spawn_tornado"},
        "radius": {"type": "number", "description": "Vortex radius (default 5.0)."},
        "duration_ticks": {"type": "integer", "minimum": 1, "description": "Lifetime (default 100)."},
        "pull_strength": {"type": "number", "description": "Horizontal pull magnitude (default 1.0)."},
        "lift_strength": {"type": "number", "description": "Upward lift magnitude (default 0.5)."},
        "spin_strength": {"type": "number", "description": "Tangential spin magnitude (default 0.5)."},
        "damage_per_interval": {"type": "number", "description": "Damage per interval (default 2.0)."},
        "damage_interval_ticks": {"type": "integer", "minimum": 1, "description": "Ticks between damage applications (default 10)."},
        "effect_type": {"type": "string", "description": "Visual palette id (client-side; optional)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:chain_to_nearest",
      "properties": {
        "type": {"const": "neoorigins:chain_to_nearest"},
        "radius": {"type": "number", "description": "Search radius (default 16)."},
        "speed": {"type": "number", "description": "Pull speed (default 1.0)."},
        "target_condition": {"$ref": "#", "description": "Optional filter \u2014 only entities matching are valid targets."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:pull_entities",
      "properties": {
        "type": {"const": "neoorigins:pull_entities"},
        "radius": {"type": "number", "description": "Pull radius (default 8)."},
        "strength": {"type": "number", "description": "Pull magnitude per entity (default 0.5)."},
        "include_players": {"type": "boolean", "description": "Whether to pull other players (default true)."},
        "entity_condition": {"$ref": "#", "description": "Optional filter on which entities to pull."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:throw_target",
      "properties": {
        "type": {"const": "neoorigins:throw_target"},
        "force": {"type": "number", "description": "Horizontal throw magnitude (default 1.5)."},
        "vertical_lift": {"type": "number", "description": "Upward push (default 0.5)."},
        "max_distance": {"type": "number", "description": "Raycast distance to find target under crosshair (default 5.0)."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:swap_with_entity",
      "properties": {
        "type": {"const": "neoorigins:swap_with_entity"},
        "radius": {"type": "number", "description": "Search radius for nearest target (default 16)."},
        "target_condition": {"$ref": "#", "description": "Optional filter on valid swap targets."}
      },
      "required": ["type"]
    },
    {
      "$comment": "neoorigins:teleport_to_marker",
      "properties": {
        "type": {"const": "neoorigins:teleport_to_marker"},
        "dx": {"type": "number", "description": "Relative X offset (used when no 'position' object)."},
