{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoorigins.example/schema/item_action.schema.json",
  "title": "NeoOrigins Item Action",
  "description": "A nested item action used by equipped_item_action / modify_inventory. The `type` field discriminates.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "description": "Item-action verb (and / consume / damage / if_else / merge_nbt / remove_enchantment / set_count). The namespace is optional and any namespace is accepted: the parser strips it and matches the leaf.",
      "pattern": "^(?:[a-z0-9_.-]+:)?(?:and|consume|damage|if_else|merge_nbt|remove_enchantment|set_count)$"
    }
  },
  "oneOf": [
    {
      "$comment": "neoorigins:and",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:and",
            "apace:and",
            "origins:and",
            "apoli:and",
            "apugli:and"
          ]
        },
        "actions": {
          "description": "Nested item actions, run in order against the same stack.",
          "type": "array",
          "items": {
            "$ref": "item_action.schema.json"
          }
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:consume",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:consume",
            "apace:consume",
            "origins:consume",
            "apoli:consume",
            "apugli:consume"
          ]
        },
        "amount": {
          "description": "Number of items to remove from the stack (default 1).",
          "type": "integer",
          "default": 1
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:damage",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:damage",
            "apace:damage",
            "origins:damage",
            "apoli:damage",
            "apugli:damage"
          ]
        },
        "amount": {
          "description": "Durability damage to apply (default 1).",
          "type": "integer",
          "default": 1
        },
        "ignore_unbreaking": {
          "description": "Apply damage even on items that would resist it (default false).",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:if_else",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:if_else",
            "apace:if_else",
            "origins:if_else",
            "apoli:if_else",
            "apugli:if_else"
          ]
        },
        "condition": {
          "description": "Item condition tested against the stack (absent → always true).",
          "$ref": "item_condition.schema.json"
        },
        "if_action": {
          "description": "Item action run when the condition matches.",
          "$ref": "item_action.schema.json"
        },
        "else_action": {
          "description": "Item action run when the condition does not match.",
          "$ref": "item_action.schema.json"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:merge_nbt",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:merge_nbt",
            "apace:merge_nbt",
            "origins:merge_nbt",
            "apoli:merge_nbt",
            "apugli:merge_nbt"
          ]
        },
        "nbt": {
          "description": "SNBT merged into the stack (e.g. {CustomModelData:3}); unknown keys land in custom_data.",
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:remove_enchantment",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:remove_enchantment",
            "apace:remove_enchantment",
            "origins:remove_enchantment",
            "apoli:remove_enchantment",
            "apugli:remove_enchantment"
          ]
        },
        "enchantment": {
          "description": "Single enchantment id to strip, e.g. minecraft:binding_curse.",
          "type": "string"
        },
        "enchantments": {
          "description": "Enchantment ids to strip; the plural form of enchantment, and may be used instead of or alongside it.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+$"
          }
        },
        "levels": {
          "description": "Levels to subtract from each named enchantment instead of removing it outright; one already at or below this level is removed. Omit to always remove outright (no default: absent and 0 differ). Nothing is clamped, which is upstream's behaviour: 0 subtracts nothing and a negative value raises the level.",
          "type": "integer"
        },
        "reset_repair_cost": {
          "description": "Also clear the stack's accumulated anvil repair cost (default false). Also read from the enclosing equipped_item_action.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:set_count",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:set_count",
            "apace:set_count",
            "origins:set_count",
            "apoli:set_count",
            "apugli:set_count"
          ]
        },
        "count": {
          "description": "New stack count (default 1).",
          "type": "integer",
          "default": 1
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "Fallback branch — any registered type not exhaustively schema'd yet. Allows extra fields permissively.",
      "properties": {
        "type": {
          "not": {
            "enum": [
              "apace:and",
              "apace:consume",
              "apace:damage",
              "apace:if_else",
              "apace:merge_nbt",
              "apace:remove_enchantment",
              "apace:set_count",
              "apoli:and",
              "apoli:consume",
              "apoli:damage",
              "apoli:if_else",
              "apoli:merge_nbt",
              "apoli:remove_enchantment",
              "apoli:set_count",
              "apugli:and",
              "apugli:consume",
              "apugli:damage",
              "apugli:if_else",
              "apugli:merge_nbt",
              "apugli:remove_enchantment",
              "apugli:set_count",
              "neoorigins:and",
              "neoorigins:consume",
              "neoorigins:damage",
              "neoorigins:if_else",
              "neoorigins:merge_nbt",
              "neoorigins:remove_enchantment",
              "neoorigins:set_count",
              "origins:and",
              "origins:consume",
              "origins:damage",
              "origins:if_else",
              "origins:merge_nbt",
              "origins:remove_enchantment",
              "origins:set_count"
            ]
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    }
  ]
}
