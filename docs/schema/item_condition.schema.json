{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoorigins.example/schema/item_condition.schema.json",
  "title": "NeoOrigins Item Condition",
  "description": "A nested item condition used by equipped_item / modify_inventory. The `type` field discriminates, and is optional: a typeless object carrying a bare `id`, `item` or `tag` is a shorthand the parser also accepts.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Item-condition verb (all_of / amount / and / any_of / armor_value / constant / custom_data / durability / empty / enchantment / food / harvest_level / ingredient / meat / name / nbt / not / or). The namespace is optional and any namespace is accepted: the parser strips it and matches the leaf. Omit `type` entirely to use the id / item / tag shorthand.",
      "pattern": "^(?:[a-z0-9_.-]+:)?(?:all_of|amount|and|any_of|armor_value|constant|custom_data|durability|empty|enchantment|food|harvest_level|ingredient|meat|name|nbt|not|or)$"
    }
  },
  "oneOf": [
    {
      "$comment": "neoorigins:amount",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:amount",
            "apace:amount",
            "origins:amount",
            "apoli:amount",
            "apugli:amount"
          ]
        },
        "comparison": {
          "description": "Comparison operator against the stack count (default >=).",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "default": ">="
        },
        "compare_to": {
          "description": "Stack count threshold (default 1).",
          "type": "integer",
          "default": 1
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:and",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:and",
            "neoorigins:all_of",
            "apace:and",
            "apace:all_of",
            "origins:and",
            "origins:all_of",
            "apoli:and",
            "apoli:all_of",
            "apugli:and",
            "apugli:all_of"
          ]
        },
        "conditions": {
          "description": "Nested item conditions; all must match (evaluated against the same stack).",
          "type": "array",
          "items": {
            "$ref": "item_condition.schema.json"
          }
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:armor_value",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:armor_value",
            "apace:armor_value",
            "origins:armor_value",
            "apoli:armor_value",
            "apugli:armor_value"
          ]
        },
        "comparison": {
          "description": "Comparison operator against the stack's armour value (default >=).",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "default": ">="
        },
        "compare_to": {
          "description": "Armour-value threshold. Counts only flat minecraft:armor bonuses on the stack, so anything that grants no armour reads 0. Note the entity condition of the same name measures the wearer's total instead.",
          "type": "number",
          "default": 0
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:constant",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:constant",
            "apace:constant",
            "origins:constant",
            "apoli:constant",
            "apugli:constant"
          ]
        },
        "value": {
          "description": "The value this condition always returns.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:durability",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:durability",
            "apace:durability",
            "origins:durability",
            "apoli:durability",
            "apugli:durability"
          ]
        },
        "comparison": {
          "description": "Comparison operator against remaining durability (default >=).",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "default": ">="
        },
        "compare_to": {
          "description": "Remaining-durability threshold: max damage minus current damage. Items that cannot take damage read 0.",
          "type": "integer",
          "default": 0
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:empty",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:empty",
            "apace:empty",
            "origins:empty",
            "apoli:empty",
            "apugli:empty"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:enchantment",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:enchantment",
            "apace:enchantment",
            "origins:enchantment",
            "apoli:enchantment",
            "apugli:enchantment"
          ]
        },
        "enchantment": {
          "description": "Enchantment id checked on the stack itself (e.g. minecraft:sharpness).",
          "type": "string"
        },
        "comparison": {
          "description": "Comparison operator against the enchantment level (default >=).",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "default": ">="
        },
        "compare_to": {
          "description": "Enchantment level threshold (default 1).",
          "type": "integer",
          "default": 1
        }
      },
      "required": [
        "type",
        "enchantment"
      ]
    },
    {
      "$comment": "neoorigins:food",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:food",
            "apace:food",
            "origins:food",
            "apoli:food",
            "apugli:food"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:harvest_level",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:harvest_level",
            "apace:harvest_level",
            "origins:harvest_level",
            "apoli:harvest_level",
            "apugli:harvest_level"
          ]
        },
        "comparison": {
          "description": "Comparison operator against the tool tier (default >=).",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "default": ">="
        },
        "compare_to": {
          "description": "Tier threshold: wood/gold 0, stone 1, iron 2, diamond 3, netherite 4. Minecraft dropped numeric harvest levels in 1.20.5, so the tier is read back from the tier tag on the tool; anything that is not a tool reads 0.",
          "type": "integer",
          "default": 0
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:ingredient",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:ingredient",
            "apace:ingredient",
            "origins:ingredient",
            "apoli:ingredient",
            "apugli:ingredient"
          ]
        },
        "item": {
          "description": "Exact item id to match (e.g. minecraft:diamond).",
          "type": "string"
        },
        "tag": {
          "description": "Item tag the stack must be in (e.g. minecraft:planks). May also be nested under an `ingredient` key, including vanilla's array form ([{\"tag\": ...}, {\"item\": ...}]) which matches when any entry matches.",
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:meat",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:meat",
            "apace:meat",
            "origins:meat",
            "apoli:meat",
            "apugli:meat"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:name",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:name",
            "apace:name",
            "origins:name",
            "apoli:name",
            "apugli:name"
          ]
        },
        "name": {
          "description": "Exact display-name text the stack's hover name must equal (custom name, else default item name).",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    {
      "$comment": "neoorigins:nbt",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:nbt",
            "neoorigins:custom_data",
            "apace:nbt",
            "apace:custom_data",
            "origins:nbt",
            "origins:custom_data",
            "apoli:nbt",
            "apoli:custom_data",
            "apugli:nbt",
            "apugli:custom_data"
          ]
        },
        "nbt": {
          "description": "SNBT subtree the stack's legacy-view NBT must contain (e.g. {foo:1} or {Potion:\"minecraft:swiftness\"}). Data components are projected back into the pre-1.21 layout (Potion, Enchantments, display.Name, ...) merged over minecraft:custom_data.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "nbt"
      ]
    },
    {
      "$comment": "neoorigins:not",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:not",
            "apace:not",
            "origins:not",
            "apoli:not",
            "apugli:not"
          ]
        },
        "condition": {
          "description": "Nested item condition that must NOT match.",
          "$ref": "item_condition.schema.json"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:or",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:or",
            "neoorigins:any_of",
            "apace:or",
            "apace:any_of",
            "origins:or",
            "origins:any_of",
            "apoli:or",
            "apoli:any_of",
            "apugli:or",
            "apugli:any_of"
          ]
        },
        "conditions": {
          "description": "Nested item conditions; at least one must match.",
          "type": "array",
          "items": {
            "$ref": "item_condition.schema.json"
          }
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "Typeless shorthand — ItemConditionParser's default arm reads a bare id / item / tag with no `type`.",
      "not": {
        "required": [
          "type"
        ]
      },
      "properties": {
        "id": {
          "description": "Item id the stack must be, e.g. minecraft:diamond_sword. Ignored when `item` is also present.",
          "type": "string",
          "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+$"
        },
        "item": {
          "description": "Alias for `id`, and preferred over it when both are present.",
          "type": "string",
          "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+$"
        },
        "tag": {
          "description": "Item tag the stack must be in, e.g. minecraft:swords (no leading #).",
          "type": "string",
          "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+$"
        },
        "inverted": {
          "description": "When true the whole check is negated. Read by ItemConditionParser.parse for every item condition, typed or not.",
          "type": "boolean",
          "default": false
        }
      },
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "item"
          ]
        },
        {
          "required": [
            "tag"
          ]
        }
      ]
    },
    {
      "$comment": "Fallback branch — any registered type not exhaustively schema'd yet. Allows extra fields permissively.",
      "properties": {
        "type": {
          "not": {
            "enum": [
              "apace:all_of",
              "apace:amount",
              "apace:and",
              "apace:any_of",
              "apace:armor_value",
              "apace:constant",
              "apace:custom_data",
              "apace:durability",
              "apace:empty",
              "apace:enchantment",
              "apace:food",
              "apace:harvest_level",
              "apace:ingredient",
              "apace:meat",
              "apace:name",
              "apace:nbt",
              "apace:not",
              "apace:or",
              "apoli:all_of",
              "apoli:amount",
              "apoli:and",
              "apoli:any_of",
              "apoli:armor_value",
              "apoli:constant",
              "apoli:custom_data",
              "apoli:durability",
              "apoli:empty",
              "apoli:enchantment",
              "apoli:food",
              "apoli:harvest_level",
              "apoli:ingredient",
              "apoli:meat",
              "apoli:name",
              "apoli:nbt",
              "apoli:not",
              "apoli:or",
              "apugli:all_of",
              "apugli:amount",
              "apugli:and",
              "apugli:any_of",
              "apugli:armor_value",
              "apugli:constant",
              "apugli:custom_data",
              "apugli:durability",
              "apugli:empty",
              "apugli:enchantment",
              "apugli:food",
              "apugli:harvest_level",
              "apugli:ingredient",
              "apugli:meat",
              "apugli:name",
              "apugli:nbt",
              "apugli:not",
              "apugli:or",
              "neoorigins:all_of",
              "neoorigins:amount",
              "neoorigins:and",
              "neoorigins:any_of",
              "neoorigins:armor_value",
              "neoorigins:constant",
              "neoorigins:custom_data",
              "neoorigins:durability",
              "neoorigins:empty",
              "neoorigins:enchantment",
              "neoorigins:food",
              "neoorigins:harvest_level",
              "neoorigins:ingredient",
              "neoorigins:meat",
              "neoorigins:name",
              "neoorigins:nbt",
              "neoorigins:not",
              "neoorigins:or",
              "origins:all_of",
              "origins:amount",
              "origins:and",
              "origins:any_of",
              "origins:armor_value",
              "origins:constant",
              "origins:custom_data",
              "origins:durability",
              "origins:empty",
              "origins:enchantment",
              "origins:food",
              "origins:harvest_level",
              "origins:ingredient",
              "origins:meat",
              "origins:name",
              "origins:nbt",
              "origins:not",
              "origins:or"
            ]
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    }
  ]
}
