{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoorigins.example/schema/block_condition.schema.json",
  "title": "NeoOrigins Block Condition",
  "description": "A nested block condition used by on_block / block / in_block / near_block. The `type` field discriminates.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "description": "Block-condition verb (adjacent / and / block / block_state / exposed_to_sky / fluid / height / in_tag / light_level / movement_blocking / offset / or). The namespace is optional and any namespace is accepted: the parser strips it and matches the leaf.",
      "pattern": "^(?:[a-z0-9_.-]+:)?(?:adjacent|and|block|block_state|exposed_to_sky|fluid|height|in_tag|light_level|movement_blocking|offset|or)$"
    }
  },
  "oneOf": [
    {
      "$comment": "neoorigins:adjacent",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:adjacent",
            "apace:adjacent",
            "origins:adjacent",
            "apoli:adjacent",
            "apugli:adjacent"
          ]
        },
        "adjacent_condition": {
          "description": "Block condition tested against each of the six face neighbours.",
          "$ref": "block_condition.schema.json"
        },
        "comparison": {
          "description": "Comparison operator against the matching-neighbour count (default >=).",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "default": ">="
        },
        "compare_to": {
          "description": "Neighbour-count threshold, 0..6 (default 1 — i.e. \"any matching neighbour\").",
          "type": "number",
          "default": 1.0
        }
      },
      "required": [
        "type",
        "adjacent_condition"
      ]
    },
    {
      "$comment": "neoorigins:and",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:and",
            "apace:and",
            "origins:and",
            "apoli:and",
            "apugli:and"
          ]
        },
        "conditions": {
          "description": "Nested block conditions; all must match (evaluated against the same block).",
          "type": "array",
          "items": {
            "$ref": "block_condition.schema.json"
          }
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:block",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:block",
            "apace:block",
            "origins:block",
            "apoli:block",
            "apugli:block"
          ]
        },
        "block": {
          "description": "Block id to match (e.g. minecraft:water).",
          "type": "string"
        },
        "id": {
          "description": "Legacy alias for `block`.",
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:block_state",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:block_state",
            "apace:block_state",
            "origins:block_state",
            "apoli:block_state",
            "apugli:block_state"
          ]
        },
        "property": {
          "description": "Blockstate property name (e.g. waterlogged, facing, level). A block without it never matches.",
          "type": "string"
        },
        "value": {
          "description": "Required property value, or a list of accepted values. Booleans and numbers may be written unquoted.",
          "type": "string"
        },
        "enum": {
          "description": "Origins spelling of `value` for named properties (e.g. \"south\"); a list is also accepted.",
          "type": "string"
        },
        "comparison": {
          "description": "For numeric properties: compare the value instead of matching it. Overrides value/enum.",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ]
        },
        "compare_to": {
          "description": "Number the property value is compared against (default 0).",
          "type": "number",
          "default": 0.0
        }
      },
      "required": [
        "type",
        "property"
      ]
    },
    {
      "$comment": "neoorigins:exposed_to_sky",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:exposed_to_sky",
            "apace:exposed_to_sky",
            "origins:exposed_to_sky",
            "apoli:exposed_to_sky",
            "apugli:exposed_to_sky"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:fluid",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:fluid",
            "apace:fluid",
            "origins:fluid",
            "apoli:fluid",
            "apugli:fluid"
          ]
        },
        "fluid_condition": {
          "description": "Condition on the fluid at the tested position. Types: `in_tag` (with `tag`), `fluid` (with `fluid`/`id`), `empty`, `still`, `constant` (with `value`), and `and`/`or` over `conditions[]`. Every node also honours `inverted`.",
          "type": "object"
        }
      },
      "required": [
        "type",
        "fluid_condition"
      ]
    },
    {
      "$comment": "neoorigins:height",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:height",
            "apace:height",
            "origins:height",
            "apoli:height",
            "apugli:height"
          ]
        },
        "comparison": {
          "description": "Comparison operator against the block's Y coordinate (default >=).",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "default": ">="
        },
        "compare_to": {
          "description": "Y level to compare against (default 0; 63 is sea level).",
          "type": "number",
          "default": 0.0
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:in_tag",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:in_tag",
            "apace:in_tag",
            "origins:in_tag",
            "apoli:in_tag",
            "apugli:in_tag"
          ]
        },
        "tag": {
          "description": "Block tag the block must be in (e.g. minecraft:ice).",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tag"
      ]
    },
    {
      "$comment": "neoorigins:light_level",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:light_level",
            "apace:light_level",
            "origins:light_level",
            "apoli:light_level",
            "apugli:light_level"
          ]
        },
        "comparison": {
          "description": "Comparison operator against the light level (default >=).",
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ],
          "default": ">="
        },
        "compare_to": {
          "description": "Light level to compare against, 0..15 (default 0).",
          "type": "integer",
          "default": 0
        },
        "light_type": {
          "description": "Which light to read (default any — the effective local brightness).",
          "type": "string",
          "enum": [
            "sky",
            "block",
            "any"
          ],
          "default": "any"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:movement_blocking",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:movement_blocking",
            "apace:movement_blocking",
            "origins:movement_blocking",
            "apoli:movement_blocking",
            "apugli:movement_blocking"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:offset",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:offset",
            "apace:offset",
            "origins:offset",
            "apoli:offset",
            "apugli:offset"
          ]
        },
        "condition": {
          "description": "Nested block condition evaluated at the offset position; absent → matches all blocks (warned at load).",
          "$ref": "block_condition.schema.json"
        },
        "x": {
          "description": "X offset in blocks (default 0).",
          "type": "integer",
          "default": 0
        },
        "y": {
          "description": "Y offset in blocks (default 0).",
          "type": "integer",
          "default": 0
        },
        "z": {
          "description": "Z offset in blocks (default 0).",
          "type": "integer",
          "default": 0
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "neoorigins:or",
      "properties": {
        "type": {
          "enum": [
            "neoorigins:or",
            "apace:or",
            "origins:or",
            "apoli:or",
            "apugli:or"
          ]
        },
        "conditions": {
          "description": "Nested block conditions; at least one must match.",
          "type": "array",
          "items": {
            "$ref": "block_condition.schema.json"
          }
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "$comment": "Fallback branch — any registered type not exhaustively schema'd yet. Allows extra fields permissively.",
      "properties": {
        "type": {
          "not": {
            "enum": [
              "apace:adjacent",
              "apace:and",
              "apace:block",
              "apace:block_state",
              "apace:exposed_to_sky",
              "apace:fluid",
              "apace:height",
              "apace:in_tag",
              "apace:light_level",
              "apace:movement_blocking",
              "apace:offset",
              "apace:or",
              "apoli:adjacent",
              "apoli:and",
              "apoli:block",
              "apoli:block_state",
              "apoli:exposed_to_sky",
              "apoli:fluid",
              "apoli:height",
              "apoli:in_tag",
              "apoli:light_level",
              "apoli:movement_blocking",
              "apoli:offset",
              "apoli:or",
              "apugli:adjacent",
              "apugli:and",
              "apugli:block",
              "apugli:block_state",
              "apugli:exposed_to_sky",
              "apugli:fluid",
              "apugli:height",
              "apugli:in_tag",
              "apugli:light_level",
              "apugli:movement_blocking",
              "apugli:offset",
              "apugli:or",
              "neoorigins:adjacent",
              "neoorigins:and",
              "neoorigins:block",
              "neoorigins:block_state",
              "neoorigins:exposed_to_sky",
              "neoorigins:fluid",
              "neoorigins:height",
              "neoorigins:in_tag",
              "neoorigins:light_level",
              "neoorigins:movement_blocking",
              "neoorigins:offset",
              "neoorigins:or",
              "origins:adjacent",
              "origins:and",
              "origins:block",
              "origins:block_state",
              "origins:exposed_to_sky",
              "origins:fluid",
              "origins:height",
              "origins:in_tag",
              "origins:light_level",
              "origins:movement_blocking",
              "origins:offset",
              "origins:or"
            ]
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    }
  ]
}
